# Servidor Jenkins LTS (JDK 21) con Docker CLI, Docker Compose y Python 3 para CI
FROM jenkins/jenkins:lts-jdk21

USER root

# Instalar Python 3, entorno virtual y utilidades de red para pruebas automatizadas
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar cliente Docker oficial y plugins buildx / compose con version fijada
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=docker/compose-bin:v2.29.7 /docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

# Permitir acceso seguro a directorios Git montados en el workspace
RUN git config --system --add safe.directory '*'

USER jenkins
